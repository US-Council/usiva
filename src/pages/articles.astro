---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  briefMap,
  briefSourceMap,
  briefsLastChecked,
  editorialBoundary,
  immigrationBriefs,
} from '../data/briefs';

const title = 'USIVA Full Briefs | Immigration research desk';
const description =
  'Full USIVA source-led briefs on purpose of travel, route mapping, agency roles, record readiness, I-9 and E-Verify, case handoffs, and official immigration data.';

const relatedBriefs = (slugs: readonly string[]) =>
  slugs.map((slug) => briefMap.get(slug)).filter((brief): brief is NonNullable<typeof brief> => Boolean(brief));

const citationsFor = (brief: (typeof immigrationBriefs)[number], sourceIds: readonly string[]) =>
  sourceIds
    .map((sourceId) => {
      const source = briefSourceMap.get(sourceId);
      const index = brief.sourceIds.indexOf(sourceId);
      return source && index >= 0 ? { source, index: index + 1 } : null;
    })
    .filter((citation): citation is NonNullable<typeof citation> => Boolean(citation));
---

<SiteLayout
  title={title}
  description={description}
  canonical="/articles.html"
  activePath="/articles.html"
  topbarMessage={`Full briefs · source trail last checked ${briefsLastChecked}`}
  topbarLink={{ label: 'Return to the brief index', href: '/briefs.html' }}
  ogType="article"
>
  <div class="articles-page">
    <section class="articles-hero" aria-labelledby="articles-heading">
      <div class="shell-container articles-hero__grid">
        <div>
          <p class="eyebrow">USIVA research desk / full reading</p>
          <h1 id="articles-heading">Seven briefs for the work before the decision.</h1>
          <p class="articles-hero__dek">
            Each document below is built to be read on its own: a thesis, a decision map, a practical record or
            workflow, explicit caveats, and direct links to the official sources checked on {briefsLastChecked}.
          </p>
        </div>
        <aside class="articles-hero__note">
          <p class="articles-hero__note-label">Reading contract</p>
          <p class="articles-hero__note-title">Orient first. Verify before action.</p>
          <p>
            These are static editorial documents for public reading. Each provides a thesis, source trail, caveat,
            and handoff to the current agency, school, sponsor, employer, or attorney instruction.
          </p>
          <a class="button button--gold" href="#purpose-of-travel-and-classification">Open brief 01</a>
        </aside>
      </div>
    </section>

    <nav class="article-index" aria-label="Full brief index">
      <div class="shell-container article-index__inner">
        <p class="article-index__label">On this desk</p>
        <ol>
          {immigrationBriefs.map((brief) => (
            <li><a href={`#${brief.slug}`}><span>{brief.number}</span>{brief.title}</a></li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="articles-library">
      {immigrationBriefs.map((brief) => (
        <article class="research-article" id={brief.slug} data-article-route={`/articles.html#${brief.slug}`}>
          <div class="shell-container">
            <header class="research-article__header">
              <p class="research-article__kicker">Brief {brief.number} / {brief.label}</p>
              <h2>{brief.title}</h2>
              <p class="research-article__deck">{brief.deck}</p>
              <dl class="research-article__meta">
                <div><dt>Audience</dt><dd>{brief.audience}</dd></div>
                <div><dt>Last checked</dt><dd>{briefsLastChecked}</dd></div>
                <div><dt>Reading path</dt><dd><a href={`/articles.html#${brief.slug}`}>/articles.html#{brief.slug}</a></dd></div>
              </dl>
            </header>

            <div class="research-article__grid">
              <aside class="research-article__rail">
                <div class="article-thesis">
                  <p class="article-thesis__label">Working thesis</p>
                  <p>{brief.thesis}</p>
                </div>
                <div class="article-takeaway">
                  <p class="article-takeaway__label">Carry forward</p>
                  <p>{brief.takeaway}</p>
                </div>
                <nav aria-label={`Sections in ${brief.title}`}>
                  <p class="article-contents__label">In this brief</p>
                  <ol class="article-contents">
                    {brief.sections.map((section, index) => (
                      <li><a href={`#${brief.slug}-${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.heading}</a></li>
                    ))}
                  </ol>
                </nav>
              </aside>

              <div class="research-article__body">
                <p class="article-opening"><strong>The short version.</strong> {brief.thesis}</p>

                {brief.sections.map((section) => (
                  <section class="article-section" id={`${brief.slug}-${section.id}`} aria-labelledby={`${brief.slug}-${section.id}-heading`}>
                    <header>
                      <p class="article-section__number" aria-hidden="true">{section.id.replaceAll('-', ' ')}</p>
                      <h3 id={`${brief.slug}-${section.id}-heading`}>{section.heading}</h3>
                      {section.intro && <p class="article-section__intro">{section.intro}</p>}
                    </header>

                    {section.paragraphs && (
                      <div class="article-prose">
                        {section.paragraphs.map((item) => (
                          <p>
                            {item.text}
                            {item.sourceIds && citationsFor(brief, item.sourceIds).map(({ source, index }) => (
                              <sup class="article-citation"><a href={`#${brief.slug}-source-${source.id}`} aria-label={`Source ${index}: ${source.label}`}>[{index}]</a></sup>
                            ))}
                          </p>
                        ))}
                      </div>
                    )}

                    {section.bullets && (
                      <ul class="article-bullets">
                        {section.bullets.map((bullet) => <li>{bullet}</li>)}
                      </ul>
                    )}

                    {section.steps && (
                      <ol class="article-steps">
                        {section.steps.map((step, index) => (
                          <li>
                            <span class="article-steps__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                            <div><h4>{step.label}</h4><p>{step.text}</p></div>
                          </li>
                        ))}
                      </ol>
                    )}

                    {section.table && (
                      <div class="article-table-wrap">
                        <table>
                          <caption>{section.table.caption}</caption>
                          <thead><tr>{section.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                          <tbody>
                            {section.table.rows.map((row) => (
                              <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}

                    {section.note && <aside class="article-note"><strong>Boundary note.</strong> {section.note}</aside>}

                    {section.sourceIds && citationsFor(brief, section.sourceIds).length > 0 && (
                      <p class="article-section__sources">
                        <span>Source basis</span>
                        {citationsFor(brief, section.sourceIds).map(({ source, index }) => (
                          <a href={`#${brief.slug}-source-${source.id}`} aria-label={`Source ${index}: ${source.label}`}>[{index}] {source.label}</a>
                        ))}
                      </p>
                    )}
                  </section>
                ))}

                <section class="article-related" aria-labelledby={`${brief.slug}-related-heading`}>
                  <p class="eyebrow">Keep the question moving</p>
                  <h3 id={`${brief.slug}-related-heading`}>Related desks</h3>
                  <ul>
                    {relatedBriefs(brief.relatedSlugs).map((related) => (
                      <li><a href={`#${related.slug}`}><span>{related.number}</span><strong>{related.title}</strong><em>Open brief →</em></a></li>
                    ))}
                  </ul>
                </section>

                <section class="article-sources" aria-labelledby={`${brief.slug}-sources-heading`}>
                  <div class="article-sources__header">
                    <p class="eyebrow">Official source rail</p>
                    <h3 id={`${brief.slug}-sources-heading`}>Read the record behind the brief.</h3>
                    <p>Links support verification; reopen the live source before acting.</p>
                  </div>
                  <ol>
                    {brief.sourceIds.map((sourceId, index) => {
                      const source = briefSourceMap.get(sourceId);
                      return source && (
                        <li id={`${brief.slug}-source-${source.id}`}>
                          <span class="article-sources__index" aria-hidden="true">[{index + 1}]</span>
                          <div>
                            <a href={source.url} rel="noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
                            <p>{source.publisher} · checked {source.lastChecked}</p>
                            <code>{source.url}</code>
                            <small>{source.why}</small>
                          </div>
                        </li>
                      );
                    })}
                  </ol>
                  <p class="article-sources__footer">Last checked: {briefsLastChecked}. Verify current requirements with the relevant official agency.</p>
                </section>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="articles-boundary section" aria-labelledby="articles-boundary-heading">
      <div class="shell-container articles-boundary__grid">
        <div>
          <p class="eyebrow">A clear limit</p>
          <h2 id="articles-boundary-heading">The source trail points to the responsible authority.</h2>
        </div>
        <div>
          <p>{editorialBoundary}</p>
          <a class="button button--light" href="/contacts.html">Prepare a careful handoff</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .articles-page {
    background: var(--color-paper);
    overflow: clip;
  }

  .articles-hero {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: clamp(2.75rem, 5vw, 5rem) var(--space-4);
  }

  .articles-hero .eyebrow {
    color: var(--color-paper);
  }

  .articles-hero__grid {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
  }

  .articles-hero h1 {
    color: var(--color-paper);
    font-size: clamp(2.8rem, 6vw, 5.7rem);
    letter-spacing: -0.065em;
    line-height: 0.92;
    max-width: 14ch;
  }

  .articles-hero__dek {
    color: var(--color-on-dark-muted);
    font-size: var(--step-1);
    margin-block-start: var(--space-3);
    max-width: 55ch;
  }

  .articles-hero__note {
    border-block: 1px solid var(--color-line-dark);
    padding-block: var(--space-2);
  }

  .articles-hero__note-label,
  .articles-hero__note-title {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .articles-hero__note-title {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-block: 1rem;
    text-transform: none;
  }

  .articles-hero__note > p:not(.articles-hero__note-label):not(.articles-hero__note-title) {
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
    margin-block-end: var(--space-2);
  }

  .article-index {
    background: var(--color-mist);
    border-bottom: 1px solid var(--color-line);
    border-top: 1px solid var(--color-line-dark);
  }

  .article-index__inner {
    align-items: start;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 9rem 1fr;
    padding-block: var(--space-2);
  }

  .article-index__label,
  .article-contents__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
  }

  .article-index a {
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
  }

  .article-index a span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    margin-inline-end: 0.45rem;
  }

  .research-article {
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 8rem;
  }

  .research-article:nth-child(even) {
    background: var(--color-canvas);
  }

  .research-article__header {
    border-bottom: 1px solid var(--color-line);
    margin-inline-start: max(0rem, calc((100% - 78rem) / 6));
    max-width: 66rem;
    padding-block-end: var(--space-3);
  }

  .research-article__kicker,
  .research-article__meta dt,
  .article-section__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .research-article__header h2 {
    font-size: clamp(2.9rem, 6vw, 6.4rem);
    letter-spacing: -0.065em;
    line-height: 0.94;
    margin-block: var(--space-2) var(--space-2);
    max-width: 15ch;
  }

  .research-article__deck {
    font-size: var(--step-1);
    max-width: 62ch;
  }

  .research-article__meta {
    border-top: 1px solid var(--color-line);
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: 1fr 1fr 1.2fr;
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-1);
  }

  .research-article__meta > div {
    display: grid;
    gap: 0.25rem;
  }

  .research-article__meta dt {
    font-size: 0.72rem;
  }

  .research-article__meta dd {
    color: var(--color-ink);
    font-size: var(--step--1);
    margin: 0;
  }

  .research-article__meta a {
    overflow-wrap: anywhere;
  }

  .research-article__grid {
    display: grid;
    gap: clamp(2rem, 7vw, 8rem);
    grid-template-columns: minmax(13rem, 0.35fr) minmax(0, 1.65fr);
    margin-block-start: var(--space-4);
  }

  .research-article__rail {
    align-self: start;
    position: sticky;
    top: 8rem;
  }

  .article-thesis,
  .article-takeaway {
    border-top: 0.28rem solid var(--color-gold);
    margin-block-end: var(--space-3);
    padding-block-start: var(--space-1);
  }

  .article-takeaway {
    border-top-color: var(--color-teal);
  }

  .article-thesis__label,
  .article-takeaway__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    margin-block-end: 0.45rem;
    text-transform: uppercase;
  }

  .article-thesis p:last-child,
  .article-takeaway p:last-child {
    color: var(--color-ink);
    font-size: var(--step--1);
  }

  .article-contents {
    border-top: 1px solid var(--color-line);
    list-style: none;
    margin-block-start: 0.7rem;
  }

  .article-contents li {
    border-bottom: 1px solid var(--color-line);
  }

  .article-contents a {
    align-items: start;
    color: var(--color-muted);
    display: grid;
    font-size: 0.78rem;
    gap: 0.55rem;
    grid-template-columns: 1.7rem 1fr;
    padding-block: 0.55rem;
    text-decoration: none;
  }

  .article-contents a:hover {
    color: var(--color-accent-dark);
  }

  .article-contents a span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .research-article__body {
    min-width: 0;
  }

  .article-opening {
    background: var(--color-mist);
    border-inline-start: 0.35rem solid var(--color-gold);
    color: var(--color-ink);
    font-size: var(--step-1);
    line-height: 1.55;
    margin-block-end: var(--space-4);
    max-width: 70ch;
    padding: var(--space-2);
  }

  .article-section {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-3);
    scroll-margin-top: 8rem;
  }

  .article-section > header {
    margin-block-end: var(--space-2);
  }

  .article-section__number {
    color: var(--color-soft);
    font-size: 0.72rem;
    margin-block-end: 0.45rem;
  }

  .article-section h3 {
    font-size: var(--step-2);
    max-width: 22ch;
  }

  .article-section__intro {
    font-size: var(--step-0);
    max-width: 62ch;
  }

  .article-prose {
    max-width: 70ch;
  }

  .article-prose p,
  .article-steps p,
  .article-bullets li {
    font-size: var(--step-0);
    line-height: 1.75;
  }

  .article-prose p + p {
    margin-block-start: var(--space-1);
  }

  .article-citation {
    font-family: var(--font-mono);
    font-size: 0.72em;
    margin-inline-start: 0.18rem;
    vertical-align: super;
  }

  .article-citation a {
    color: var(--color-accent-dark);
    font-weight: 800;
    text-decoration: none;
  }

  .article-bullets {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin-block: var(--space-2);
    max-width: 70ch;
  }

  .article-bullets li {
    border-bottom: 1px solid var(--color-line);
    padding: 0 0 var(--space-1) 1.5rem;
    position: relative;
  }

  .article-bullets li::before {
    color: var(--color-accent);
    content: '—';
    left: 0;
    position: absolute;
  }

  .article-steps {
    border-top: 1px solid var(--color-line);
    counter-reset: brief-step;
    list-style: none;
    max-width: 70ch;
  }

  .article-steps li {
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 1rem;
    grid-template-columns: 3.2rem 1fr;
    padding-block: var(--space-1);
  }

  .article-steps__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding-block-start: 0.25rem;
  }

  .article-steps h4 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: 0;
    margin-block-end: 0.25rem;
  }

  .article-table-wrap {
    margin-block: var(--space-2);
    max-width: 100%;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    min-width: 42rem;
    width: 100%;
  }

  caption {
    color: var(--color-muted);
    font-size: var(--step--1);
    font-style: italic;
    margin-block-end: 0.8rem;
    text-align: left;
  }

  th,
  td {
    border: 1px solid var(--color-line);
    padding: 0.8rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    font-size: var(--step--1);
    font-weight: 800;
  }

  tbody th {
    background: var(--color-mist);
    color: var(--color-ink);
    font-size: var(--step--1);
    min-width: 9rem;
  }

  tbody td {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .article-note {
    background: var(--color-highlight-surface);
    border-inline-start: 0.3rem solid var(--color-gold);
    color: var(--color-ink);
    font-size: var(--step--1);
    margin-block: var(--space-2);
    max-width: 70ch;
    padding: var(--space-1) var(--space-2);
  }

  .article-section__sources {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    margin-block-start: var(--space-2);
  }

  .article-section__sources span {
    color: var(--color-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-section__sources a {
    color: var(--color-accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .article-related {
    border-top: 0.3rem solid var(--color-teal);
    margin-block: var(--space-4) var(--space-3);
    padding-block: var(--space-2);
  }

  .article-related h3 {
    font-size: var(--step-2);
  }

  .article-related ul {
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .article-related li {
    border-bottom: 1px solid var(--color-line);
  }

  .article-related a {
    align-items: center;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 2rem 1fr auto;
    padding-block: 0.8rem;
    text-decoration: none;
  }

  .article-related a > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .article-related strong {
    color: var(--color-ink);
    font-size: var(--step--1);
  }

  .article-related em {
    color: var(--color-accent-dark);
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 800;
    text-transform: uppercase;
  }

  .article-sources {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    margin-block-start: var(--space-4);
    padding: clamp(1.4rem, 4vw, 3rem);
  }

  .article-sources h3 {
    color: var(--color-paper);
    font-size: var(--step-2);
    max-width: 18ch;
  }

  .article-sources__header > p:last-child {
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
  }

  .article-sources > ol {
    border-top: 1px solid var(--color-line-dark);
    list-style: none;
    margin-block-start: var(--space-3);
  }

  .article-sources > ol > li {
    border-bottom: 1px solid var(--color-line-dark);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2.3rem 1fr;
    padding-block: var(--space-1);
    scroll-margin-top: 8rem;
  }

  .article-sources__index {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .article-sources a {
    color: var(--color-paper);
    font-size: var(--step--1);
    font-weight: 850;
  }

  .article-sources a span {
    color: var(--color-highlight);
  }

  .article-sources p,
  .article-sources small,
  .article-sources code {
    color: var(--color-on-dark-muted);
    display: block;
    font-size: 0.78rem;
    line-height: 1.5;
    margin-block-start: 0.25rem;
  }

  .article-sources code {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .article-sources small {
    max-width: 72ch;
