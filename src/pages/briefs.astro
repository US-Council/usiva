---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  briefSources,
  briefsLastChecked,
  editorialBoundary,
  immigrationBriefs,
} from '../data/briefs';

const title = 'USIVA Research Briefs | Source-led immigration planning';
const description =
  'Source-led USIVA briefs for visa classification, route mapping, agency roles, evidence, employment verification, case handoffs, and immigration data.';
const featuredBrief = immigrationBriefs[0];
const representativeSources = briefSources.slice(0, 8);
---

<SiteLayout
  title={title}
  description={description}
  activePath="/briefs.html"
  topbarMessage={`Research desk · last checked ${briefsLastChecked}`}
  topbarLink={{ label: 'Read the USIVA boundary', href: '#boundary' }}
>
  <div class="briefs-page">
    <section class="briefs-hero" aria-labelledby="briefs-heading">
      <div class="shell-container briefs-hero__grid">
        <div class="briefs-hero__copy">
          <p class="eyebrow">USIVA research desk / 2026</p>
          <h1 id="briefs-heading">Seven source-led briefs for visa planning.</h1>
          <p class="briefs-hero__dek">
            Full, source-led briefs for the moments when an immigration question is still being named:
            purpose, route, agency, evidence, work, status, and data.
          </p>
          <div class="briefs-hero__actions">
            <a class="button button--gold" href={`#${featuredBrief.slug}`}>Start with classification</a>
            <a class="button button--outline" href="#source-protocol">See the source protocol</a>
          </div>
        </div>

        <aside class="briefs-hero__ledger" aria-label="Research desk ledger">
          <p class="briefs-hero__ledger-label">Desk ledger</p>
          <p class="briefs-hero__ledger-number">{String(immigrationBriefs.length).padStart(2, '0')}</p>
          <p class="briefs-hero__ledger-title">briefs in the first source set</p>
          <dl>
            <div><dt>Source family</dt><dd>Official agency pages</dd></div>
            <div><dt>Last checked</dt><dd>{briefsLastChecked}</dd></div>
            <div><dt>Reading rule</dt><dd>Orient, then verify</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="briefs-intro section section--paper" aria-labelledby="intro-heading">
      <div class="shell-container briefs-intro__grid">
        <div>
          <p class="eyebrow">How to use the desk</p>
          <h2 id="intro-heading">A source trail is part of the answer.</h2>
        </div>
        <div class="briefs-intro__copy">
          <p>
            These briefs explain how to frame a question and where to hand it off. Each turns public information
            into a documented orientation path, names the official source that supports it, and keeps the last-checked
            date visible.
          </p>
          <p>
            Read the article that matches the decision in front of you, record the facts that make your situation
            different, and then verify current requirements with the relevant official agency, school, sponsor,
            employer, or qualified immigration attorney.
          </p>
        </div>
      </div>
    </section>

    <section class="briefs-index section" aria-labelledby="index-heading">
      <div class="shell-container">
        <header class="briefs-index__header">
          <div>
            <p class="eyebrow">The index / seven desks</p>
            <h2 id="index-heading">Choose the decision you need to make clearer.</h2>
          </div>
          <p>
            Each entry opens a complete long-form brief on the research desk. Use the numbered source notes at the
            end of each article to inspect the official pages directly.
          </p>
        </header>

        <ol class="brief-index">
          {immigrationBriefs.map((brief) => (
            <li id={brief.slug}>
              <article class="brief-card">
                <header class="brief-card__header">
                  <div class="brief-card__number" aria-hidden="true">{brief.number}</div>
                  <div>
                    <p class="brief-card__label">{brief.label}</p>
                    <h3><a href={`/articles.html#${brief.slug}`}>{brief.title}</a></h3>
                  </div>
                </header>
                <p class="brief-card__deck">{brief.deck}</p>
                <dl class="brief-card__facts">
                  <div><dt>For</dt><dd>{brief.audience}</dd></div>
                  <div><dt>Carry forward</dt><dd>{brief.takeaway}</dd></div>
                </dl>
                <a class="brief-card__link" href={`/articles.html#${brief.slug}`}>
                  Read the full brief <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="source-protocol section section--night" id="source-protocol" aria-labelledby="protocol-heading">
      <div class="shell-container source-protocol__grid">
        <div class="source-protocol__lead">
          <p class="eyebrow">The source protocol</p>
          <h2 id="protocol-heading">Read broadly. Decide narrowly.</h2>
          <p>
            A live official page can change after a brief is published. The date on this desk tells you when the
            source trail was last checked; the live source controls current rules, forms, fees, processing estimates,
            and local instructions.
          </p>
        </div>
        <ol class="source-protocol__steps">
          <li><span>01</span><div><strong>Name the decision.</strong><p>Classification, route, agency, evidence, employment, status, or research method.</p></div></li>
          <li><span>02</span><div><strong>Open the owner’s source.</strong><p>Use the official page linked in the article as the current source for the question.</p></div></li>
          <li><span>03</span><div><strong>Record the date and fit.</strong><p>Note the last checked date, the source’s scope, and the questions it leaves for another authority.</p></div></li>
          <li><span>04</span><div><strong>Verify before acting.</strong><p>Ask the relevant agency, school, sponsor, employer, or qualified attorney about current requirements.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="source-preview section section--paper" aria-labelledby="source-preview-heading">
      <div class="shell-container source-preview__grid">
        <header>
          <p class="eyebrow">Representative source rail</p>
          <h2 id="source-preview-heading">The desk starts with the public record.</h2>
          <p>
            The full source list is attached to each article. These are the first pages to open when you are still
            locating the right vocabulary.
          </p>
        </header>
        <ol class="source-preview__list">
          {representativeSources.map((source, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <a href={source.url} rel="noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
                <small>{source.publisher} · checked {source.lastChecked}</small>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="briefs-boundary section" id="boundary" aria-labelledby="boundary-heading">
      <div class="shell-container briefs-boundary__grid">
        <div>
          <p class="eyebrow">Boundary / read before you rely</p>
          <h2 id="boundary-heading">Useful orientation has a clear limit.</h2>
        </div>
        <div>
          <p>{editorialBoundary}</p>
          <p class="briefs-boundary__action">
            <strong>Next action:</strong> bring one concrete question, one source record, and one decision date to the
            authority responsible for your situation.
          </p>
          <a class="button button--primary" href="/contacts.html">Prepare a question brief</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .briefs-page {
    overflow: clip;
  }

  .briefs-hero {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: clamp(2.75rem, 5vw, 5rem) var(--space-4);
  }

  .briefs-hero .eyebrow {
    color: var(--color-paper);
  }

  .briefs-hero__grid {
    align-items: end;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
  }

  .briefs-hero__copy {
    max-width: 58rem;
  }

  .briefs-hero h1 {
    color: var(--color-paper);
    font-size: clamp(2.8rem, 7vw, 6rem);
    letter-spacing: -0.07em;
    line-height: 0.9;
    max-width: 13ch;
  }

  .briefs-hero__dek {
    color: var(--color-on-dark-muted);
    font-size: var(--step-1);
    margin-block: var(--space-3) 0;
    max-width: 42ch;
  }

  .briefs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: var(--space-3);
  }

  .briefs-hero__ledger {
    border-block: 1px solid var(--color-line-dark);
    padding-block: var(--space-2);
  }

  .briefs-hero__ledger-label,
  .briefs-hero__ledger-title {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .briefs-hero__ledger-number {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 10rem);
    letter-spacing: -0.08em;
    line-height: 0.85;
    margin-block: var(--space-2) 0.7rem;
  }

  .briefs-hero__ledger dl {
    border-top: 1px solid var(--color-line-dark);
    margin-block-start: var(--space-3);
  }

  .briefs-hero__ledger dl > div {
    align-items: baseline;
    border-bottom: 1px solid var(--color-line-dark);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 1fr 1.2fr;
    padding-block: 0.7rem;
  }

  .briefs-hero__ledger dt,
  .briefs-hero__ledger dd {
    font-size: var(--step--1);
    margin: 0;
  }

  .briefs-hero__ledger dt {
    color: var(--color-on-dark-muted);
  }

  .briefs-hero__ledger dd {
    color: var(--color-paper);
    font-weight: 750;
  }

  .briefs-intro__grid,
  .briefs-boundary__grid {
    display: grid;
    gap: clamp(2rem, 8vw, 9rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }

  .briefs-intro h2,
  .briefs-boundary h2 {
    font-size: var(--step-3);
    max-width: 13ch;
  }

  .briefs-intro__copy {
    max-width: 65ch;
  }

  .briefs-intro__copy p {
    font-size: var(--step-0);
  }

  .briefs-intro__copy p + p {
    margin-block-start: var(--space-2);
  }

  .briefs-index {
    background: var(--color-canvas);
  }

  .briefs-index__header {
    align-items: end;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    margin-block-end: var(--space-4);
  }

  .briefs-index__header h2 {
    font-size: var(--step-3);
    max-width: 15ch;
  }

  .briefs-index__header > p {
    border-inline-start: 0.25rem solid var(--color-gold);
    padding-inline-start: var(--space-2);
  }

  .brief-index {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
  }

  .brief-index > li {
    background: var(--color-line);
  }

  .brief-index > li:first-child {
    grid-column: 1 / -1;
  }

  .brief-card {
    background: var(--color-paper);
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
    padding: clamp(1.4rem, 3vw, 2.7rem);
  }

  .brief-index > li:first-child .brief-card {
    background: var(--color-navy);
    color: var(--color-paper);
  }

  .brief-card__header {
    align-items: start;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 4rem 1fr;
  }

  .brief-card__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    padding-block-start: 0.12rem;
  }

  .brief-index > li:first-child .brief-card__number,
  .brief-index > li:first-child .brief-card__label {
    color: var(--color-paper);
  }

  .brief-card__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.09em;
    margin-block-end: 0.6rem;
    text-transform: uppercase;
  }

  .brief-card h3 {
    font-size: var(--step-1);
    max-width: 24ch;
  }

  .brief-index > li:first-child .brief-card h3,
  .brief-index > li:first-child .brief-card h3 a,
  .brief-index > li:first-child .brief-card__deck,
  .brief-index > li:first-child .brief-card__facts dd {
    color: var(--color-paper);
  }

  .brief-card h3 a {
    text-decoration: none;
  }

  .brief-card h3 a:hover {
    color: var(--color-accent-dark);
  }

  .brief-card__deck {
    margin-block: var(--space-2) var(--space-3);
    max-width: 62ch;
  }

  .brief-card__facts {
    border-top: 1px solid var(--color-line);
    margin-block: auto var(--space-3);
  }

  .brief-index > li:first-child .brief-card__facts {
    border-color: var(--color-line-dark);
  }

  .brief-card__facts > div {
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 1rem;
    grid-template-columns: 7rem 1fr;
    padding-block: 0.7rem;
  }

  .brief-index > li:first-child .brief-card__facts > div {
    border-color: var(--color-line-dark);
  }

  .brief-card__facts dt,
  .brief-card__facts dd {
    font-size: var(--step--1);
    margin: 0;
  }

  .brief-card__facts dt {
    color: var(--color-soft);
    font-weight: 800;
    text-transform: uppercase;
  }

  .brief-index > li:first-child .brief-card__facts dt {
    color: var(--color-on-dark-muted);
  }

  .brief-card__facts dd {
    color: var(--color-ink);
  }

  .brief-card__link {
    align-items: center;
    color: var(--color-accent-dark);
    display: inline-flex;
    font-size: var(--step--1);
    font-weight: 850;
    gap: 0.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .brief-index > li:first-child .brief-card__link {
    color: var(--color-paper);
  }

  .brief-card__link span {
    font-size: 1.2em;
    transition: transform 180ms ease;
  }

  .brief-card__link:hover span {
    transform: translateX(0.2rem);
  }

  .source-protocol {
    background: var(--color-navy);
  }

  .source-protocol__grid {
    display: grid;
    gap: clamp(2rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .source-protocol h2 {
    color: var(--color-paper);
    font-size: var(--step-3);
    max-width: 12ch;
  }

  .source-protocol__lead > p:last-child {
    color: var(--color-on-dark-muted);
    max-width: 48ch;
  }

  .source-protocol__steps {
    border-top: 1px solid var(--color-line-dark);
    list-style: none;
  }

  .source-protocol__steps li {
    border-bottom: 1px solid var(--color-line-dark);
    display: grid;
    gap: 1rem;
    grid-template-columns: 3rem 1fr;
    padding-block: var(--space-2);
  }

  .source-protocol__steps li > span {
    color: var(--color-on-dark-muted);
    font-family: var(--font-mono);
  }

  .source-protocol__steps strong {
    color: var(--color-paper);
    display: block;
    margin-block-end: 0.2rem;
  }

  .source-protocol__steps p {
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
  }

  .source-preview__grid {
    display: grid;
    gap: clamp(2rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .source-preview h2 {
    font-size: var(--step-3);
    max-width: 13ch;
  }

  .source-preview header > p:last-child {
    max-width: 44ch;
  }

  .source-preview__list {
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .source-preview__list li {
    align-items: start;
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
    padding-block: 0.9rem;
  }

  .source-preview__list li > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .source-preview__list a {
    color: var(--color-ink);
    font-weight: 800;
    text-decoration-thickness: 0.12em;
  }

  .source-preview__list a span {
    color: var(--color-accent);
  }

  .source-preview__list small {
    color: var(--color-soft);
    display: block;
    font-size: 0.78rem;
    margin-block-start: 0.25rem;
  }

  .briefs-boundary {
    background: var(--color-accent);
    color: var(--color-paper);
  }

  .briefs-boundary h2 {
    color: var(--color-paper);
  }

  .briefs-boundary p {
    color: var(--color-on-dark-muted);
    max-width: 65ch;
  }

  .briefs-boundary__action {
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-2);
  }

  @media (max-width: 820px) {
    .briefs-hero__grid,
    .briefs-intro__grid,
    .briefs-index__header,
    .source-protocol__grid,
    .source-preview__grid,
    .briefs-boundary__grid {
      grid-template-columns: 1fr;
    }

    .briefs-hero__ledger {
      max-width: 34rem;
    }
  }

  @media (max-width: 620px) {
    .brief-index {
      grid-template-columns: 1fr;
    }

    .brief-index > li:first-child {
      grid-column: auto;
    }

    .brief-card__header {
      grid-template-columns: 3rem 1fr;
    }

    .brief-card__facts > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .briefs-hero h1 {
      font-size: clamp(3.5rem, 19vw, 6rem);
    }
  }
</style>
