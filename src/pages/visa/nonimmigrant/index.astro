---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VisaDirectory from '../../../components/VisaDirectory.astro';
import { nonimmigrantCategories, nonimmigrantFamilies } from '../../../data/visa-categories';

const routePath = '/visa/nonimmigrant.html';
const title = 'Nonimmigrant visa categories | USIVA';
const description = 'Browse source-aware nonimmigrant visa categories from A through V, plus NATO, TN, and other official temporary pathways.';
---

<BaseLayout
  title={title}
  description={description}
  activePath={routePath}
  canonical={routePath}
  topbarMessage="Source-aware visa orientation; verify current instructions with the responsible authority."
  topbarLink={{ label: 'Read the public boundary', href: '/about.html' }}
>
  <article class="track-page">
    <header class="track-hero">
      <div class="track-shell">
        <p class="eyebrow">USIVA / nonimmigrant index</p>
        <h1>Temporary travel is a purpose question before it is a code question.</h1>
        <p>Browse the principal letter families A through V, NATO and TN variants, and other official temporary pathways. Open a family index when you want the surrounding context; open a category when you need a source trail.</p>
      </div>
    </header>
    <div class="track-shell track-content">
      <VisaDirectory
        track="nonimmigrant"
        categories={nonimmigrantCategories}
        families={nonimmigrantFamilies}
        heading="Nonimmigrant category index"
        description="Each record names the audience, purpose, official source, official next step, and planning topics for the responsible authority’s eligibility and outcome review."
      />
    </div>
  </article>
</BaseLayout>

<style>
  .track-page {
    background: var(--color-canvas);
  }

  .track-shell {
    margin-inline: auto;
    max-width: var(--measure-wide);
    padding-inline: var(--gutter);
  }

  .track-hero {
    background: var(--color-mist);
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(3rem, 6vw, 5rem) var(--space-4);
  }

  .track-hero h1 {
    color: var(--color-navy-deep);
    font-size: clamp(2.3rem, 5vw, 4.45rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
    max-width: 15ch;
  }

  .track-hero p:last-child {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    margin-block-start: var(--space-2);
    max-width: 62ch;
  }

  .track-content {
    padding-block-start: var(--space-4);
  }

  @media (max-width: 620px) {
    .track-shell {
      padding-inline: 1rem;
    }
  }
</style>
