---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { directoryPath, visaCatalogReviewDate, visaCatalogStats } from '../../data/visa-categories';

const routePath = '/visa.html';
const title = 'Visa pathways | USIVA source-aware catalog';
const description = 'A source-aware USIVA index for temporary and permanent U.S. visa pathways, with official links and planning boundaries.';
---

<BaseLayout
  title={title}
  description={description}
  activePath={routePath}
  canonical={routePath}
  topbarMessage="Source-aware visa orientation; verify current instructions with the responsible authority."
  topbarLink={{ label: 'Read the public boundary', href: '/about.html' }}
>
  <article class="visa-landing">
    <section class="landing-hero" aria-labelledby="landing-heading">
      <div class="landing-shell landing-hero__grid">
        <div>
          <p class="eyebrow">USIVA / visa pathways</p>
          <h1 id="landing-heading">Start with the purpose. Keep the source trail.</h1>
          <p class="landing-hero__lede">This catalog organizes official U.S. visa categories into readable routes. Use it to name the question, find the government source, and prepare a more useful next conversation.</p>
          <div class="landing-actions">
            <a class="button button--primary" href="/visa-categories.html">Open the full catalog <span aria-hidden="true">→</span></a>
            <a class="button button--outline" href="/visa/nonimmigrant.html">Browse temporary routes</a>
          </div>
        </div>
        <aside class="landing-brief" aria-label="Catalog scope">
          <p class="landing-brief__label">Catalog scope</p>
          <p><strong>{visaCatalogStats.total}</strong> category records</p>
          <p>{visaCatalogStats.nonimmigrant} nonimmigrant · {visaCatalogStats.immigrant} immigrant</p>
          <p class="landing-brief__note">Reviewed {visaCatalogReviewDate} in the source ledger.</p>
        </aside>
      </div>
    </section>

    <section class="track-section" aria-labelledby="track-heading">
      <div class="landing-shell">
        <div class="section-heading">
          <p class="eyebrow">Choose the track</p>
          <h2 id="track-heading">Two different questions need two different maps.</h2>
          <p>Temporary travel and permanent immigration use different official workflows, source agencies, and planning handoffs. Start with the track that matches the decision in front of you.</p>
        </div>

        <div class="track-grid">
          <a class="track-card track-card--temporary" href={directoryPath('nonimmigrant')}>
            <span class="track-card__code">01 / NIV</span>
            <h3>Nonimmigrant routes</h3>
            <p>Temporary travel, study, exchange, employment, official assignments, family derivatives, and humanitarian categories.</p>
            <span class="track-card__link">Open {visaCatalogStats.nonimmigrant} route records <span aria-hidden="true">↗</span></span>
          </a>
          <a class="track-card track-card--permanent" href={directoryPath('immigrant')}>
            <span class="track-card__code">02 / IV</span>
            <h3>Immigrant routes</h3>
            <p>Family, adoption, employment, special immigrant, diversity, K, and returning-resident routes for permanent immigration questions.</p>
            <span class="track-card__link">Open {visaCatalogStats.immigrant} route records <span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="source-band" aria-labelledby="source-band-heading">
      <div class="landing-shell source-band__grid">
        <div>
          <p class="eyebrow eyebrow--light">How to use a route</p>
          <h2 id="source-band-heading">A category label starts the conversation; the source guides the next step.</h2>
        </div>
        <ol>
          <li><span>01</span><p><strong>Name the purpose.</strong> Separate study, work, transit, family, official travel, and permanent immigration.</p></li>
          <li><span>02</span><p><strong>Open the source.</strong> Use the linked State Department or USCIS page, then check the responsible post or program.</p></li>
          <li><span>03</span><p><strong>Prepare the handoff.</strong> Keep dates, documents, owners, and unresolved questions together.</p></li>
        </ol>
      </div>
    </section>

    <section class="landing-note" aria-label="Planning boundary">
      <div class="landing-shell">
        <p><strong>Planning boundary:</strong> USIVA catalog pages organize purpose, source, and next steps. The responsible authority determines eligibility, status, work authorization, admissibility, visa issuance, and timing; qualified counsel provides individualized advice.</p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .visa-landing {
    background: var(--color-canvas);
  }

  .landing-shell {
    margin-inline: auto;
    max-width: var(--measure-wide);
    padding-inline: var(--gutter);
  }

  .landing-hero {
    background: var(--color-mist);
    border-bottom: 1px solid var(--color-line);
  }

  .landing-hero__grid {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.55fr);
    min-height: 31rem;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .landing-hero h1 {
    color: var(--color-navy-deep);
    font-size: clamp(2.4rem, 5vw, 4.7rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
    max-width: 12ch;
  }

  .landing-hero__lede {
    color: var(--color-ink);
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.5;
    margin-block-start: var(--space-3);
    max-width: 52ch;
  }

  .landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: var(--space-3);
  }

  .button {
    align-items: center;
    border: 1px solid transparent;
    display: inline-flex;
    font-size: var(--step--1);
    font-weight: 850;
    gap: 0.55rem;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    text-align: center;
    text-decoration: none;
  }

  .button--primary {
    background: var(--color-accent);
    color: var(--color-paper);
  }

  .button--primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-paper);
  }

  .button--outline {
    border-color: var(--color-navy-soft);
    color: var(--color-navy);
  }

  .button--outline:hover {
    background: var(--color-paper);
    color: var(--color-navy-deep);
  }

  .landing-brief {
    border-top: 0.35rem solid var(--color-highlight);
    background: var(--color-navy-deep);
    box-shadow: 1rem 1rem 0 rgba(9, 27, 45, 0.12);
    color: var(--color-paper);
    padding: var(--space-2);
  }

  .landing-brief__label {
    color: var(--color-highlight);
    font-size: var(--step--1);
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
  }

  .landing-brief p {
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
    margin: 0 0 0.55rem;
  }

  .landing-brief p:nth-of-type(2) {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .landing-brief strong {
    color: var(--color-highlight);
    font-size: 2.15rem;
    line-height: 0.9;
  }

  .landing-brief__note {
    border-top: 1px solid rgba(214, 225, 229, 0.25);
    margin-top: var(--space-2) !important;
    padding-top: var(--space-2);
  }

  .track-section {
    padding-block: var(--space-5);
  }

  .section-heading {
    max-width: 52rem;
  }

  .section-heading h2,
  .source-band h2 {
    color: var(--color-navy-deep);
    font-size: clamp(1.8rem, 3vw, 3.1rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .section-heading > p:last-child {
    font-size: var(--step-0);
  }

  .track-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--space-3);
  }

  .track-card {
    display: grid;
    min-height: 18rem;
    padding: var(--space-3);
    text-decoration: none;
  }

  .track-card--temporary {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .track-card--permanent {
    background: var(--color-info-surface);
    border: 1px solid var(--color-line);
  }

  .track-card:hover {
    color: var(--color-ink);
    transform: translateY(-0.2rem);
  }

  .track-card__code {
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .track-card h3 {
    align-self: end;
    color: var(--color-navy-deep);
    font-size: clamp(1.55rem, 2.4vw, 2.2rem);
    line-height: 1;
    margin-block: var(--space-4) 0.7rem;
  }

  .track-card p {
    margin: 0;
    max-width: 46ch;
  }

  .track-card__link {
    align-self: end;
    color: var(--color-accent-dark);
    font-size: var(--step--1);
    font-weight: 850;
    margin-top: var(--space-3);
  }

  .source-band {
    background: var(--color-navy);
    color: var(--color-paper);
    padding-block: var(--space-5);
  }

  .source-band h2 {
    color: var(--color-paper);
  }

  .eyebrow--light {
    color: var(--color-paper);
  }

  .source-band__grid {
    display: grid;
    gap: clamp(2rem, 7vw, 8rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr);
  }

  .source-band ol {
    border-top: 1px solid rgba(214, 225, 229, 0.28);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .source-band li {
    border-bottom: 1px solid rgba(214, 225, 229, 0.28);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    padding-block: var(--space-2);
  }

  .source-band li > span {
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 850;
  }

  .source-band li p {
    color: var(--color-on-dark-muted);
    margin: 0;
  }

  .source-band li strong {
    color: var(--color-paper);
  }

  .landing-note {
    background: var(--color-highlight);
    color: var(--color-navy-deep);
    padding-block: 1rem;
  }

  .landing-note p {
    color: var(--color-navy-deep);
    font-size: var(--step--1);
    margin: 0;
    max-width: none;
  }

  .landing-note strong {
    color: var(--color-navy-deep);
  }

  @media (max-width: 820px) {
    .landing-hero__grid,
    .source-band__grid,
    .track-grid {
      grid-template-columns: 1fr;
    }

    .landing-hero__grid {
      min-height: 0;
    }

    .landing-brief {
      box-shadow: none;
      max-width: 32rem;
    }
  }

  @media (max-width: 620px) {
    .landing-shell {
      padding-inline: 1rem;
    }

    .landing-actions,
    .landing-actions .button {
      width: 100%;
    }

    .landing-actions .button {
      min-height: 3.25rem;
    }
  }
</style>
