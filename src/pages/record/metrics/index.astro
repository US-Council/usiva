---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecordSidebar from '../../../components/RecordSidebar.astro';
import RecordCard from '../../../components/RecordCard.astro';
import SectionIntro from '../../../components/SectionIntro.astro';

const title = 'Content Inventory | Record Room';
const description = 'USIVA Record Room: content inventory and editorial metrics.';
const canonical = 'https://usiva.org/record/metrics.html';

const sidebarGroups = [
  {
    label: 'Company',
    items: [
      { label: 'Company facts', href: '/record.html' },
      { label: 'Leadership', href: '/record/leadership.html' },
    ],
  },
  {
    label: 'Evidence',
    items: [
      { label: 'Federal records', href: '/record/federal.html' },
      { label: 'Source register', href: '/record/verify.html' },
      { label: 'Documents', href: '/record/files.html' },
    ],
  },
  {
    label: 'Website archive',
    items: [
      { label: 'Site map', href: '/record/nav.html' },
      { label: 'Content inventory', href: '/record/metrics.html' },
      { label: 'Visual archive', href: '/record/style.html' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { label: 'Business status', href: '/record/ops.html' },
      { label: 'Brand guide', href: '/record/style.html' },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  activePath="/record/metrics.html"
  canonical={canonical}
  topbarMessage="Record Room · content inventory and editorial metrics"
  topbarLink={{ label: 'Open official tools', href: '/official-tools.html' }}
>
  <section class="section" aria-labelledby="page-title">
    <div class="shell-container record-layout">
      <RecordSidebar activePath="/record/metrics.html" groups={sidebarGroups} />

      <div class="record-content">
        <SectionIntro eyebrow="01 · Inventory" title="Content inventory" description="An overview of USIVA's planning content, organized by type and reference area." />

        <div class="card-grid">
          <RecordCard title="Research briefs" description="Short, source-led notes about planning and compliance questions, each with a traceable source trail." tag="Content" href="/briefs.html" />
          <RecordCard title="Articles" description="Longer explanations as general planning content, with clear limitations noted." tag="Content" href="/articles.html" />
          <RecordCard title="Visa categories" description="A complete index of nonimmigrant and immigrant categories with official-source orientation." tag="Reference" href="/visa-categories.html" />
        </div>

        <SectionIntro eyebrow="02 · Metrics" title="Editorial metrics" description="Measures of content coverage and source verification across the USIVA site." />

        <div class="card-grid">
          <RecordCard title="Source coverage" description="Each brief references named official sources with a last-checked date for verification." tag="Standards" href="/briefs.html" />
          <RecordCard title="Route coverage" description="The visa category catalog covers nonimmigrant and immigrant families across the A–V index." tag="Scope" href="/visa-categories.html" />
          <RecordCard title="Currency" description="Content review dates are tracked so readers can assess the currentness of planning material." tag="Maintenance" href="/about.html" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .record-layout {
    align-items: start;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(14rem, 0.82fr) minmax(0, 1fr);
    padding-block-start: var(--space-4);
  }

  .record-content {
    min-width: 0;
  }

  .card-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--space-3);
  }

  @media (max-width: 820px) {
    .record-layout {
      grid-template-columns: 1fr;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
