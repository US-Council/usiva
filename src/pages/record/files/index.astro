---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecordSidebar from '../../../components/RecordSidebar.astro';
import RecordCard from '../../../components/RecordCard.astro';
import SectionIntro from '../../../components/SectionIntro.astro';

const title = 'Documents | Record Room';
const description = 'USIVA Record Room: documents, evidence files, and source materials.';
const canonical = 'https://usiva.org/record/files.html';

const sidebarGroups = [
  {
    label: 'Company',
    items: [
      { label: 'Company facts', href: '/record.html' },
      { label: 'Leadership', href: '/record/leadership.html' },
    ],
  },
  {
    label: 'Evidence',
    items: [
      { label: 'Federal records', href: '/record/federal.html' },
      { label: 'Source register', href: '/record/verify.html' },
      { label: 'Documents', href: '/record/files.html' },
    ],
  },
  {
    label: 'Website archive',
    items: [
      { label: 'Site map', href: '/record/nav.html' },
      { label: 'Content inventory', href: '/record/metrics.html' },
      { label: 'Visual archive', href: '/record/style.html' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { label: 'Business status', href: '/record/ops.html' },
      { label: 'Brand guide', href: '/record/style.html' },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  activePath="/record/files.html"
  canonical={canonical}
  topbarMessage="Record Room · documents and evidence files"
  topbarLink={{ label: 'Open official tools', href: '/official-tools.html' }}
>
  <section class="section" aria-labelledby="page-title">
    <div class="shell-container record-layout">
      <RecordSidebar activePath="/record/files.html" groups={sidebarGroups} />

      <div class="record-content">
        <SectionIntro eyebrow="01 · Documents" title="Documents" description="The document and evidence files that support USIVA's planning orientation." />

        <div class="card-grid">
          <RecordCard title="Evidence matrix" description="Organize identity, purpose, funding, authorization, and history records into a traceable evidence matrix before building a packet." tag="Evidence" href="/briefs.html" />
          <RecordCard title="Readiness file" description="A readiness file is useful when every important claim has a source, date, owner, and question attached to it." tag="Practice" href="/briefs.html" />
          <RecordCard title="Version control" description="Keep the history of living records instead of silently replacing the evidence that informed an earlier decision." tag="Standards" href="/briefs.html" />
        </div>

        <SectionIntro eyebrow="02 · Archives" title="Document archive" description="Where to find and how to manage the source documents behind USIVA's planning content." />

        <div class="card-grid">
          <RecordCard title="Official sources" description="The official source library provides the verified references that USIVA planning content draws upon for each route and topic." tag="Sources" href="/official-tools.html" />
          <RecordCard title="Research briefs" description="Briefs document the reasoning and source trail behind each planning topic, with check dates for every source." tag="Research" href="/briefs.html" />
          <RecordCard title="Media manifest" description="The media manifest records the photography and images used across USIVA, with focal points and source attribution." tag="Media" href="/services.html" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .record-layout {
    align-items: start;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(14rem, 0.82fr) minmax(0, 1fr);
    padding-block-start: var(--space-4);
  }

  .record-content {
    min-width: 0;
  }

  .card-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--space-3);
  }

  @media (max-width: 820px) {
    .record-layout {
      grid-template-columns: 1fr;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
