---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecordSidebar from '../../../components/RecordSidebar.astro';
import RecordCard from '../../../components/RecordCard.astro';
import SectionIntro from '../../../components/SectionIntro.astro';

const title = 'Business Status | Record Room';
const description = 'USIVA Record Room: business status and operational overview.';
const canonical = 'https://usiva.org/record/ops.html';

const sidebarGroups = [
  {
    label: 'Company',
    items: [
      { label: 'Company facts', href: '/record.html' },
      { label: 'Leadership', href: '/record/leadership.html' },
    ],
  },
  {
    label: 'Evidence',
    items: [
      { label: 'Federal records', href: '/record/federal.html' },
      { label: 'Source register', href: '/record/verify.html' },
      { label: 'Documents', href: '/record/files.html' },
    ],
  },
  {
    label: 'Website archive',
    items: [
      { label: 'Site map', href: '/record/nav.html' },
      { label: 'Content inventory', href: '/record/metrics.html' },
      { label: 'Visual archive', href: '/record/style.html' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { label: 'Business status', href: '/record/ops.html' },
      { label: 'Brand guide', href: '/record/style.html' },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  activePath="/record/ops.html"
  canonical={canonical}
  topbarMessage="Record Room · business status and operations"
  topbarLink={{ label: 'Open official tools', href: '/official-tools.html' }}
>
  <section class="section" aria-labelledby="page-title">
    <div class="shell-container record-layout">
      <RecordSidebar activePath="/record/ops.html" groups={sidebarGroups} />

      <div class="record-content">
        <SectionIntro eyebrow="01 · Operations" title="Business status" description="The operational and organizational status of USIVA as a planning companion site." />

        <div class="card-grid">
          <RecordCard title="Organizational status" description="USIVA operates as a US Council companion site providing informational visa and immigration planning content." tag="Status" href="/about.html" />
          <RecordCard title="Planning model" description="The site organizes questions, evidence, timing, and responsible handoffs rather than providing legal advice." tag="Model" href="/about.html" />
          <RecordCard title="Authority boundary" description="Eligibility, admission, employment, funding, visa issuance, and approval decisions belong to the responsible authority." tag="Boundary" href="/about.html" />
        </div>

        <SectionIntro eyebrow="02 · Resources" title="Operational resources" description="The tools and references that support USIVA's planning operations." />

        <div class="card-grid">
          <RecordCard title="Question brief" description="Prepare a concise, safer handoff by naming the decision, record, and open question." tag="Tool" href="/contacts.html" />
          <RecordCard title="Official tools" description="Government case-status, visa, and employer resources for current instructions." tag="Sources" href="/official-tools.html" />
          <RecordCard title="Research briefs" description="Source-led analysis of planning questions with traceable references and check dates." tag="Research" href="/briefs.html" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .record-layout {
    align-items: start;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(14rem, 0.82fr) minmax(0, 1fr);
    padding-block-start: var(--space-4);
  }

  .record-content {
    min-width: 0;
  }

  .card-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--space-3);
  }

  @media (max-width: 820px) {
    .record-layout {
      grid-template-columns: 1fr;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
