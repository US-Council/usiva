---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Route map | USIVA"
  description="Choose a route from USIVA’s current public map for visa categories, planning questions, official tools, and source-aware reference pages."
  activePath="/404.html"
  canonical="https://usiva.org/404.html"
  noindex={true}
  topbarMessage="USIVA route map · informational planning only."
  topbarLink={{ label: 'Open the route atlas', href: '/other-pages.html' }}
>
  <section class="error-state" aria-labelledby="error-heading">
    <div class="shell-container error-state__inner">
      <p class="eyebrow">404 · choose a route</p>
      <h1 id="error-heading">Choose a route from the USIVA map.</h1>
      <p class="error-state__lede">USIVA organizes visa categories, planning questions, official tools, and source-aware reference pages into a clear public route map.</p>
      <div class="error-state__actions">
        <a class="button button--primary" href="/">Return to USIVA home</a>
        <a class="button button--outline" href="/other-pages.html">Open the route atlas</a>
      </div>
    </div>
  </section>

  <section class="section error-links" aria-labelledby="error-links-heading">
    <div class="shell-container">
      <p class="eyebrow">Try a known route</p>
      <h2 id="error-links-heading">Start with the question in front of you.</h2>
      <ul>
        <li><a href="/visa.html"><strong>Browse visa routes</strong><span>Start with the directory and its official-source handoffs.</span></a></li>
        <li><a href="/official-tools.html"><strong>Verify a government task</strong><span>Open official case-status, visa, and employer tools.</span></a></li>
        <li><a href="/contacts.html"><strong>Prepare a question brief</strong><span>Organize the stage, purpose, date, and unclear item.</span></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .error-state {
    background: var(--color-navy-deep);
    color: var(--color-paper);
  }

  .error-state__inner {
    min-height: min(34rem, 58vh);
    padding-block: var(--space-5);
  }

  .error-state h1 {
    color: var(--color-paper);
    max-width: 19ch;
  }

  .error-state .eyebrow {
    color: var(--color-highlight);
  }

  .error-state__lede {
    color: var(--color-on-dark-muted);
    font-size: var(--step-1);
    margin-block-start: var(--space-2);
    max-width: 54ch;
  }

  .error-state__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }

  .error-links {
    background: var(--color-paper);
  }

  .error-links h2 {
    max-width: 24ch;
  }

  .error-links ul {
    border-top: 1px solid var(--color-line);
    list-style: none;
    margin-block-start: var(--space-3);
  }

  .error-links li {
    border-bottom: 1px solid var(--color-line);
  }

  .error-links a {
    display: grid;
    gap: 0.25rem 1rem;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
    padding-block: var(--space-2);
    text-decoration: none;
  }

  .error-links strong {
    color: var(--color-ink);
  }

  .error-links span {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 620px) {
    .error-state__actions .button {
      width: 100%;
    }

    .error-links a {
      grid-template-columns: 1fr;
    }
  }
</style>
