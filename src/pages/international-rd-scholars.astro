---
import ActionLinks from '../components/ActionLinks.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SourceList from '../components/SourceList.astro';
import type { Action } from '../components/types';
import BaseLayout from '../layouts/BaseLayout.astro';

const heroActions: Action[] = [
  { label: 'Open program context', href: 'https://usfellows.org/international-rd-scholars.html', tone: 'gold', external: true },
  { label: 'Return to all visa journeys', href: '/', tone: 'outline' },
];

const scopeItems = [
  'Organize records, dates, and questions across application, study, and post-completion stages.',
  'Separate university-controlled assistantship, CPT, OPT, and STEM OPT questions before activity begins.',
  'Point to primary government resources and the office or professional that must answer the live question.',
];

const limits = [
  'US Fellows, the school, and the employer own program applications, admissions, funding, and employment decisions.',
  'USIVA organizes eligibility questions, official-source handoffs, and records for review by the responsible authority or qualified counsel.',
  'School, DSO, sponsor, employer, consular, agency, and qualified-counsel instructions control the live question.',
];

const stages = [
  {
    stage: '01 / Before applying',
    title: 'Build the record',
    text: 'Check identity, academic history, English-proficiency requirements, funding assumptions, prior visa history, and the school or program questions that still need an answer.',
  },
  {
    stage: '02 / Admission and visa',
    title: 'Coordinate the F-1 sequence',
    text: 'After a school decision, confirm the Form I-20 and SEVIS path, DS-160 information, financial evidence, interview preparation, and school-specific instructions.',
  },
  {
    stage: '03 / During study',
    title: 'Keep activity authorized',
    text: 'Treat the full course of study, assistantship, on-campus work, CPT questions, travel, and research-partner activity as separate items for DSO and university review.',
  },
  {
    stage: '04 / After completion',
    title: 'Verify the next work question',
    text: 'For OPT or possible STEM OPT, connect the degree, field, dates, employer, training plan, reporting duties, and current USCIS or DHS instructions before relying on a plan.',
  },
];

const workBoundaries = [
  { label: 'Assistantship', text: 'A university-controlled role with duties, funding, and status questions defined by the institution.' },
  { label: 'CPT', text: 'Curricular practical training that requires the applicable school authorization before activity begins.' },
  { label: 'OPT', text: 'Post-completion or other practical training questions tied to field, timing, filing, and authorization.' },
  { label: 'STEM OPT', text: 'An extension discussion that adds degree, employer, training-plan, and reporting requirements.' },
];

const sources = [
  { label: 'U.S. Department of State: Student visa', href: 'https://travel.state.gov/content/travel/en/us-visas/study/student-visa.html' },
  { label: 'DHS Study in the States: School Search', href: 'https://studyinthestates.dhs.gov/school-search' },
  { label: 'DHS Study in the States: Maintain Your Status', href: 'https://studyinthestates.dhs.gov/students/maintain-your-status' },
  { label: 'DHS Study in the States: Working in the United States', href: 'https://studyinthestates.dhs.gov/students/resources/working' },
  { label: 'USCIS: Optional Practical Training for F-1 Students', href: 'https://www.uscis.gov/working-in-the-united-states/students-and-exchange-visitors/optional-practical-training-opt-for-f-1-students' },
  { label: 'DHS Study in the States: STEM OPT Hub', href: 'https://studyinthestates.dhs.gov/stem-opt-hub' },
];

const sourceActions: Action[] = [
  { label: 'Open Student Visa guidance', href: 'https://travel.state.gov/content/travel/en/us-visas/study/student-visa.html', tone: 'primary', external: true },
  { label: 'Open USCIS OPT guidance', href: 'https://www.uscis.gov/working-in-the-united-states/students-and-exchange-visitors/optional-practical-training-opt-for-f-1-students', tone: 'outline', external: true },
];

const finalActions: Action[] = [
  { label: 'Open program context', href: 'https://usfellows.org/international-rd-scholars.html', tone: 'gold', external: true },
  { label: 'Start a broader visa question', href: '/contacts.html', tone: 'light' },
];
---

<BaseLayout
  title="International R&D Scholars | USIVA Companion"
  description="USIVA's companion for the International R&D Scholars Program: F-1 readiness, university coordination, work-authorization boundaries, and official-source handoffs."
  activePath="/international-rd-scholars.html"
  topbarMessage="A bounded visa-readiness companion for one research program."
  topbarLink={{ label: 'Explore all visa journeys', href: '/' }}
  ogImage="/assets/photos/usiva-evidence-desk.webp"
>
  <section class="rd-hero" aria-labelledby="rd-title">
    <div class="shell-container rd-hero__inner">
      <div class="rd-hero__copy">
        <p class="eyebrow">One program / USIVA companion</p>
        <h1 id="rd-title">International R&amp;D Scholars, with a clear visa-readiness scope.</h1>
        <p class="rd-hero__lede">USIVA’s companion page serves people considering the US Fellows International R&amp;D Scholars Program. It covers F-1 study, university coordination, authorized practical training, and responsible handoffs; program applications and individualized legal advice belong to the responsible program, school, agency, or qualified counsel.</p>
        <ActionLinks actions={heroActions} />
      </div>

      <figure class="rd-hero__figure">
        <img
          src="/assets/photos/usiva-evidence-desk.webp"
          alt="Hands turn a blank page beside a calendar, notebook, ruler, and folder on a dark desk."
          width="1448"
          height="1086"
          sizes="(min-width: 1100px) 40vw, (min-width: 700px) 48vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption><span>Evidence / 01</span> A readiness file makes the next question visible; the responsible authority evaluates the outcome.</figcaption>
      </figure>
    </div>
  </section>

  <section class="rd-section rd-section--paper" id="scope">
    <div class="shell-container">
      <SectionIntro
        eyebrow="Scope before detail"
        title="Keep the research pathway and the visa question in their proper lanes."
        description="US Fellows provides the research-program context. USIVA provides a public planning companion. The university, DSO, government agency, employer, sponsor, consulate, or qualified counsel remains responsible for the live decision."
      />

      <div class="scope-grid">
        <article class="scope-panel scope-panel--in">
          <p class="scope-panel__label">USIVA covers</p>
          <ul>
            {scopeItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="scope-panel scope-panel--out">
          <p class="scope-panel__label">Decision owners</p>
          <ul>
            {limits.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="rd-section rd-section--mist" id="timeline">
    <div class="shell-container">
      <SectionIntro
        eyebrow="Four moments to verify"
        title="The question changes as the scholar moves."
        description="Use the sequence as a conversation map, then compare each stage with current school and government instructions."
      />

      <ol class="rd-sequence">
        {stages.map((stage) => (
          <li>
            <div class="rd-sequence__stage">{stage.stage}</div>
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rd-section rd-section--night" id="boundaries">
    <div class="shell-container rd-boundary-layout">
      <div class="rd-boundary-copy">
        <p class="eyebrow">A hard boundary</p>
        <h2>Research exposure and work authorization follow separate reviews.</h2>
        <p>The program may create research or partner conversations. The school, DSO, sponsor, employer, and appropriate counsel review whether employment, compensation, or training is authorized before the activity begins.</p>
      </div>

      <figure class="rd-boundary-figure">
        <img
          src="/assets/photos/usiva-study-research.webp"
          alt="A researcher in a white coat works at a microscope in a laboratory."
          width="1536"
          height="1024"
          sizes="(min-width: 900px) 46vw, 100vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption><span>Research / 02</span> The subject matter may be scientific; the authorization question is still specific to the person, school, role, and timing.</figcaption>
      </figure>
    </div>

    <div class="shell-container">
      <div class="work-boundaries">
        {workBoundaries.map((boundary, index) => (
          <article>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{boundary.label}</h3>
            <p>{boundary.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rd-section rd-section--paper" id="sources">
    <div class="shell-container">
      <SectionIntro
        eyebrow="Official-source handoff"
        title="Verify the live rule with the authority that owns it."
        description="These public sources orient the main questions. Recheck them before acting, and pair them with school-specific instructions or individualized professional advice when the facts require it."
      />

      <div class="rd-sources-layout">
        <SourceList sources={sources} />
        <aside class="rd-source-actions" aria-label="Official source actions">
          <p class="rd-source-actions__label">Start here</p>
          <p>Use the State Department for the student-visa overview, USCIS for current authorization guidance, and the school or DSO for program-specific instructions.</p>
          <ActionLinks actions={sourceActions} />
        </aside>
      </div>
    </div>
  </section>

  <section class="rd-next" aria-labelledby="next-title">
    <div class="shell-container rd-next__inner">
      <div>
        <p class="eyebrow">Two clean handoffs</p>
        <h2 id="next-title">Use US Fellows for program context. Use USIVA for the visa-readiness question.</h2>
        <p>Keep the research file and the immigration question connected, with each page serving its own purpose and handoff.</p>
      </div>
      <ActionLinks actions={finalActions} />
    </div>
  </section>
</BaseLayout>

<style>
  .rd-hero {
    background: var(--color-navy-deep);
    color: var(--color-paper);
  }

  .rd-hero__inner {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 5vw, 5.5rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    padding-block: clamp(2.75rem, 5vw, 5rem);
  }

  .rd-hero .eyebrow,
  .rd-boundary-copy .eyebrow,
  .rd-next .eyebrow {
    color: var(--color-paper);
  }

  .rd-hero h1 {
    color: var(--color-paper);
    font-size: clamp(2.45rem, 4.5vw, 4.35rem);
    max-width: 12ch;
  }

  .rd-hero__lede {
    color: var(--color-on-dark-muted);
    font-size: clamp(1rem, 0.94rem + 0.25vw, 1.15rem);
    line-height: 1.58;
    margin-block-start: var(--space-3);
    max-width: 58ch;
  }

  .rd-hero__figure,
  .rd-boundary-figure {
    margin: 0;
  }

  .rd-hero__figure {
    border: 1px solid rgba(214, 225, 229, 0.28);
    padding: 0.55rem;
  }

  .rd-hero__figure img,
  .rd-boundary-figure img {
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .rd-hero__figure img {
    aspect-ratio: 4 / 3;
  }

  .rd-hero figcaption,
  .rd-boundary-figure figcaption {
    color: var(--color-on-dark-muted);
    font-size: 0.78rem;
    line-height: 1.45;
    padding: 0.8rem 0.35rem 0.15rem;
  }

  .rd-hero figcaption span,
  .rd-boundary-figure figcaption span {
    color: var(--color-highlight);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    margin-block-end: 0.2rem;
    text-transform: uppercase;
  }

  .rd-boundary-figure figcaption span {
    color: var(--color-on-dark);
  }

  .rd-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .rd-section--paper {
    background: var(--color-paper);
  }

  .rd-section--mist {
    background: var(--color-mist);
  }

  .rd-section--night,
  .rd-next {
    background: var(--color-navy);
    color: var(--color-paper);
  }

  .rd-section--night h2,
  .rd-section--night h3,
  .rd-next h2 {
    color: var(--color-paper);
  }

  .rd-section--night p,
  .rd-next p {
    color: var(--color-on-dark-muted);
  }

  .rd-section .section-intro h2 {
    font-size: clamp(2rem, 3.3vw, 3.15rem);
    max-width: 20ch;
  }

  .rd-section .section-intro > p:last-child {
    font-size: var(--step--1);
    max-width: 68ch;
  }

  .scope-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: clamp(2.25rem, 4vw, 3.8rem);
  }

  .scope-panel {
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }

  .scope-panel--in {
    background: var(--color-mist);
    border-top: 3px solid var(--color-teal);
  }

  .scope-panel--out {
    background: var(--color-error-surface);
    border-top: 3px solid var(--color-accent);
  }

  .scope-panel__label,
  .rd-source-actions__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-block-end: 1rem;
    text-transform: uppercase;
  }

  .scope-panel--in .scope-panel__label {
    color: var(--color-teal);
  }

  .scope-panel ul {
    list-style: none;
  }

  .scope-panel li {
    padding-inline-start: 1.15rem;
    position: relative;
  }

  .scope-panel li + li {
    margin-block-start: 0.85rem;
  }

  .scope-panel li::before {
    color: var(--color-accent);
    content: '—';
    left: 0;
    position: absolute;
  }

  .scope-panel--in li::before {
    color: var(--color-teal);
  }

  .scope-panel li {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .rd-sequence {
    border-top: 1px solid var(--color-line);
    list-style: none;
    margin-block-start: clamp(2.25rem, 4vw, 3.8rem);
  }

  .rd-sequence li {
    align-items: start;
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 1.3rem;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(12rem, 0.85fr) 1.45fr;
    padding-block: 1.35rem;
  }

  .rd-sequence__stage {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .rd-sequence h3 {
    font-size: clamp(1.25rem, 1.08rem + 0.5vw, 1.7rem);
  }

  .rd-sequence p {
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .rd-boundary-layout {
    align-items: start;
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.85fr);
  }

  .rd-boundary-copy {
    padding-block-start: 1rem;
  }

  .rd-boundary-copy h2 {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    max-width: 13ch;
  }

  .rd-boundary-copy > p:last-child {
    font-size: var(--step--1);
    margin-block-start: var(--space-2);
    max-width: 54ch;
  }

  .rd-boundary-figure img {
    aspect-ratio: 3 / 2;
  }

  .work-boundaries {
    border-top: 1px solid rgba(214, 225, 229, 0.28);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
  }

  .work-boundaries article {
    border-bottom: 1px solid rgba(214, 225, 229, 0.28);
    padding-block: 1.2rem;
  }

  .work-boundaries article > span {
    color: var(--color-on-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .work-boundaries h3 {
    font-size: 1.25rem;
    margin-block: 0.55rem 0.35rem;
  }

  .work-boundaries p {
    font-size: 0.82rem;
    line-height: 1.5;
    padding-inline-end: 1rem;
  }

  .rd-sources-layout {
    align-items: start;
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    margin-block-start: clamp(2.25rem, 4vw, 3.8rem);
  }

  .rd-source-actions {
    border-left: 3px solid var(--color-gold);
    padding-inline-start: var(--space-2);
  }

  .rd-source-actions > p:not(.rd-source-actions__label) {
    font-size: var(--step--1);
  }

  .rd-source-actions .action-links {
    margin-block-start: var(--space-2);
  }

  .rd-next {
    padding-block: clamp(4rem, 7vw, 6rem);
  }

  .rd-next__inner {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .rd-next h2 {
    font-size: clamp(2rem, 3.5vw, 3.4rem);
    max-width: 17ch;
  }

  .rd-next__inner > div > p:last-child {
    font-size: var(--step--1);
    margin-block-start: var(--space-2);
    max-width: 58ch;
  }

  .rd-next__inner > .action-links {
    margin-block-start: 0;
  }

  @media (max-width: 900px) {
    .rd-hero__inner,
    .rd-boundary-layout,
    .rd-sources-layout,
    .rd-next__inner {
      grid-template-columns: 1fr;
    }

    .rd-hero__figure {
      max-width: 42rem;
    }

    .rd-boundary-figure {
      max-width: 36rem;
    }

    .rd-source-actions {
      border-left: 0;
      border-top: 3px solid var(--color-gold);
      padding-block-start: var(--space-2);
      padding-inline-start: 0;
    }

    .rd-next__inner > .action-links {
      margin-block-start: var(--space-2);
    }
  }

  @media (max-width: 760px) {
    .scope-grid {
      grid-template-columns: 1fr;
    }

    .rd-sequence li {
      display: grid;
      gap: 0.45rem 1rem;
      grid-template-columns: 7rem 1fr;
    }

    .rd-sequence p {
      grid-column: 2;
    }

    .work-boundaries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 500px) {
    .rd-sequence li {
      display: block;
    }

    .rd-sequence h3 {
      margin-block: 0.35rem 0.45rem;
    }

    .work-boundaries {
      grid-template-columns: 1fr;
    }
  }
</style>
