---
interface BoundaryItem {
  title: string;
  text: string;
}

interface Props {
  items: BoundaryItem[];
}

const { items } = Astro.props;
---

<ul class="boundary-grid" aria-label="Boundary considerations">
  {items.map((item, index) => (
    <li>
      <article>
        <div class="boundary-grid__heading">
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
        </div>
        <p>{item.text}</p>
      </article>
    </li>
  ))}
</ul>

<style>
  .boundary-grid {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
  }

  .boundary-grid li,
  .boundary-grid article {
    min-width: 0;
  }

  .boundary-grid article {
    border: 1px solid rgba(214, 225, 229, 0.2);
    padding: var(--space-2);
  }

  .boundary-grid__heading {
    align-items: start;
    display: flex;
    gap: 0.75rem;
  }

  .boundary-grid__heading > span {
    color: var(--color-highlight);
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding-block-start: 0.2rem;
  }

  .boundary-grid h3 {
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }

  .boundary-grid p {
    font-size: var(--step--1);
    margin-block-start: 0.8rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
