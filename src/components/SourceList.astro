---
interface Source {
  label: string;
  href: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<ul class="source-list" aria-label="Sources">
  {sources.map((source, index) => (
    <li>
      <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <a href={source.href}>
        <span class="source-list__label">{source.label}</span>
        <span class="source-list__external" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .source-list {
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .source-list li {
    align-items: baseline;
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
    min-width: 0;
  }

  .source-list li > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .source-list a {
    align-items: center;
    color: var(--color-ink);
    display: flex;
    font-weight: 800;
    gap: 0.4rem;
    min-height: 2.75rem;
    min-width: 0;
    overflow-wrap: anywhere;
    padding-block: 0.55rem;
  }

  .source-list__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .source-list__external {
    color: var(--color-accent);
    display: inline-block;
    margin-inline-start: 0.4rem;
  }
</style>
