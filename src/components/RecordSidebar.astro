---
interface SidebarItem {
  label: string;
  href: string;
}

interface SidebarGroup {
  label: string;
  items: SidebarItem[];
}

interface Props {
  activePath: string;
  groups: SidebarGroup[];
}

const { activePath, groups } = Astro.props;

const isCurrent = (href: string) => {
  const path = href.split(/[?#]/, 1)[0];
  return path === '' || path === '/index.html' ? '/' : path;
};

const isActive = (href: string) => {
  if (href.startsWith('http://') || href.startsWith('https://')) return false;
  return isCurrent(href) === isCurrent(activePath);
};
---

<nav class="record-sidebar" aria-label="Record Room navigation">
  {groups.map((group) => (
    <div class="record-sidebar__group">
      <h3 class="record-sidebar__group-label">{group.label}</h3>
      <ul class="record-sidebar__list">
        {group.items.map((item) => (
          <li>
            <a
              class:list={['record-sidebar__link', isActive(item.href) && 'record-sidebar__link--active']}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .record-sidebar {
    position: sticky;
    top: calc(4.35rem + var(--space-2));
    align-self: start;
    padding-block: var(--space-2);
  }

  .record-sidebar__group {
    margin-block-end: var(--space-3);
  }

  .record-sidebar__group-label {
    color: var(--color-soft);
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.2;
    margin-block-end: var(--space-1);
    text-transform: uppercase;
    padding-inline-start: var(--space-1);
  }

  .record-sidebar__list {
    display: grid;
    gap: 0.12rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .record-sidebar__link {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
    min-height: 2.5rem;
    padding: 0.45rem var(--space-1);
    text-decoration: none;
    border-inline-start: 2px solid transparent;
    transition: color 120ms ease, background-color 120ms ease, border-color 120ms ease;
  }

  .record-sidebar__link:hover {
    color: var(--color-ink);
    background: var(--color-mist);
  }

  .record-sidebar__link--active {
    color: var(--color-accent);
    border-inline-start-color: var(--color-accent);
    background: var(--color-mist);
  }

  .record-sidebar__link--active:hover {
    background: var(--color-mist);
  }

  @media (max-width: 900px) {
    .record-sidebar {
      position: static;
    }
  }
</style>
