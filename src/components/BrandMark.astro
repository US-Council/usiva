---
interface Props {
  tone?: 'default' | 'inverse';
  alt?: string;
}

const { tone = 'default', alt = 'USIVA' } = Astro.props;
const logoSource = tone === 'inverse' ? '/assets/usiva_dark.svg' : '/assets/usiva.svg';
---

<span class:list={['brand-mark', `brand-mark--${tone}`]}>
  <img class="brand-mark__logo" src={logoSource} alt={alt} width="219" height="72" decoding="async" />
</span>

<style>
  .brand-mark {
    align-items: center;
    display: inline-flex;
    line-height: 1;
    max-inline-size: 100%;
  }

  .brand-mark__logo {
    block-size: auto;
    inline-size: min(11.5rem, 36vw);
    max-inline-size: 100%;
  }

  .brand-mark--inverse {
    color: var(--color-on-dark);
  }

  @media (max-width: 500px) {
    .brand-mark__logo {
      inline-size: min(9.5rem, 42vw);
    }
  }
</style>
