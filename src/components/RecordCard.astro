---
interface RecordCardProps {
  title: string;
  description: string;
  tag?: string;
  href?: string;
}

const { title, description, tag, href } = Astro.props;
const Component = href ? 'a' : 'div';
---

<Component class:list={['record-card', !href && 'record-card--plain']} {...href ? { href } : {}}>
  {tag && <span class="record-card__tag">{tag}</span>}
  <h3 class="record-card__title">{title}</h3>
  <p class="record-card__description">{description}</p>
</Component>

<style>
  .record-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .record-card:hover,
  .record-card:focus-visible {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-soft);
  }

  .record-card--plain {
    pointer-events: none;
  }

  .record-card--plain:hover {
    border-color: var(--color-line);
    box-shadow: none;
  }

  .record-card__tag {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .record-card__title {
    color: var(--color-ink);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .record-card__description {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.45;
    margin: 0;
  }
</style>
