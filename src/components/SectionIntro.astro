---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <div class="section-rule" aria-hidden="true"></div>
  {description && <p>{description}</p>}
</header>

<style>
  .section-intro {
    max-width: 58rem;
    min-width: 0;
  }

  .section-intro .eyebrow {
    color: var(--section-eyebrow-color, var(--color-accent));
  }

  .section-intro h2 {
    color: var(--section-heading-color, var(--color-ink));
    font-size: var(--step-3);
    max-width: 17ch;
    overflow-wrap: anywhere;
  }

  .section-intro .section-rule {
    background: var(--section-rule-color, var(--color-gold));
  }

  .section-intro > p:last-child {
    color: var(--section-body-color, var(--color-muted));
    font-size: var(--step-0);
    max-width: 65ch;
    overflow-wrap: anywhere;
  }
</style>
