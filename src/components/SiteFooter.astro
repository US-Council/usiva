---
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="shell-container">
    <div class="site-footer__grid">
      <div class="site-footer__lead">
        <a href="/" aria-label="USIVA home">
          <BrandMark tone="inverse" />
        </a>
        <p>Informational visa planning, evidence organization, and official-source navigation for people and organizations.</p>
      </div>

      <nav class="site-footer__group" aria-label="Explore USIVA">
        <h2>Explore</h2>
        <ul class="site-footer__list">
          <li><a href="/visa-categories.html">Visa categories</a></li>
          <li><a href="/visa/nonimmigrant.html">Nonimmigrant routes</a></li>
          <li><a href="/visa/immigrant.html">Immigrant routes</a></li>
          <li><a href="/services.html">Services</a></li>
          <li><a href="/blog.html">Field notes</a></li>
          <li><a href="/about.html">About USIVA</a></li>
          <li><a href="/other-pages.html">Route atlas</a></li>
        </ul>
      </nav>

      <nav class="site-footer__group" aria-label="Prepare a question">
        <h2>Prepare</h2>
        <ul class="site-footer__list">
          <li><a href="/employers.html">Employer resources</a></li>
          <li><a href="/briefs.html">Research briefs</a></li>
          <li><a href="/contacts.html#brief-heading">Question brief</a></li>
          <li><a href="/guides/evidence-checklists.html">Evidence &amp; records</a></li>
        </ul>
      </nav>

      <nav class="site-footer__group" aria-label="Official sources">
        <h2>Official sources</h2>
        <ul class="site-footer__list">
          <li><a href="/official-tools.html">Official tools directory</a></li>
          <li><a href="https://www.uscis.gov/working-in-the-united-states/students-and-exchange-visitors/optional-practical-training-opt-for-f-1-students" rel="noreferrer">USCIS / OPT <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://studyinthestates.dhs.gov/students/resources/working" rel="noreferrer">DHS / working <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://studyinthestates.dhs.gov/stem-opt-hub" rel="noreferrer">DHS / STEM OPT Hub <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://travel.state.gov/content/travel/en/us-visas.html" rel="noreferrer">State Department / visas <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__lower">
      <div class="site-footer__notice">
        <h2>Notice</h2>
        <p>USIVA planning content provides informational visa planning, evidence organization, and official-source navigation. Government authorities and employers make decisions about admission, employment, funding, and visa issuance; qualified immigration counsel provides individualized legal advice.</p>
      </div>

      <div class="site-footer__partner">
        <span class="site-footer__label">Connected program reference</span>
        <p>For the International R&amp;D Scholars pathway, continue to the <a href="https://usfellows.org/international-rd-scholars.html" rel="noreferrer">US Fellows program page <span aria-hidden="true">↗</span></a>.</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>&copy; 2026 USIVA. A US Council companion site.</span>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-deep);
    color: var(--color-on-dark-muted);
    padding-block: var(--space-4) var(--space-3);
    --color-focus: var(--color-focus-on-dark);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(15rem, 1.5fr) repeat(3, minmax(8.5rem, 1fr));
  }

  .site-footer__lead {
    padding-inline-end: var(--space-3);
  }

  .site-footer__lead :global(.brand-mark) {
    min-width: auto;
  }

  .site-footer__lead p,
  .site-footer__notice p,
  .site-footer__partner p {
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
    line-height: 1.5;
    margin-block-start: 0.85rem;
  }

  .site-footer__lead p {
    max-width: 32ch;
  }

  .site-footer h2,
  .site-footer__label {
    color: var(--color-on-dark);
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .site-footer__list {
    display: grid;
    gap: 0.42rem;
    list-style: none;
    margin-block-start: 0.85rem;
  }

  .site-footer__list a {
    align-items: center;
    color: var(--color-on-dark-muted);
    display: inline-flex;
    font-size: var(--step--1);
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-footer__list a:hover,
  .site-footer__bottom a:hover,
  .site-footer__partner a:hover {
    color: var(--color-on-dark-link);
  }

  .site-footer__list span,
  .site-footer__partner span[aria-hidden='true'] {
    color: var(--color-on-dark-link);
    margin-inline-start: 0.2rem;
  }

  .site-footer__lower {
    border-top: 1px solid rgb(230 237 243 / 24%);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.9fr);
    margin-block-start: var(--space-3);
    padding-block: var(--space-2);
  }

  .site-footer__notice p,
  .site-footer__partner p {
    margin-block-end: 0;
  }

  .site-footer__partner {
    border-inline-start: 1px solid rgb(230 237 243 / 24%);
    padding-inline-start: var(--space-3);
  }

  .site-footer__partner a {
    align-items: center;
    color: var(--color-on-dark);
    display: inline-flex;
    font-weight: 700;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-footer__bottom {
    align-items: center;
    border-top: 1px solid rgb(230 237 243 / 24%);
    color: var(--color-on-dark-muted);
    display: flex;
    font-size: var(--step--2);
    gap: 1rem;
    justify-content: space-between;
    padding-block-start: var(--space-2);
  }

  .site-footer__bottom a {
    align-items: center;
    color: inherit;
    display: inline-flex;
    min-height: 2.75rem;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__lead {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid,
    .site-footer__lower {
      grid-template-columns: 1fr;
    }

    .site-footer__partner {
      border-inline-start: 0;
      border-top: 1px solid rgb(230 237 243 / 24%);
      padding-block-start: var(--space-2);
      padding-inline-start: 0;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
