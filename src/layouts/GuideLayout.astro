---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const { frontmatter } = Astro.props;
const title = String(frontmatter?.title ?? 'USIVA guidance');
const description = String(frontmatter?.description ?? 'USIVA informational planning guidance for international study and research pathways.');
const route = String(frontmatter?.route ?? Astro.url.pathname);
const siteRoot = Astro.site ?? new URL('https://usiva.org');
const canonicalUrl = new URL(route, siteRoot);
const socialImageUrl = new URL('/assets/usiva-social.svg', siteRoot);
const guideType = String(frontmatter?.guideType ?? 'planning guide').replaceAll('-', ' ');
const reviewedOn = String(frontmatter?.reviewedOn ?? '2026-08-22');
const directoryUrl = '/visa-categories.html';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: reviewedOn,
  author: { '@type': 'Organization', name: 'USIVA', url: siteRoot.href },
  publisher: { '@type': 'Organization', name: 'USIVA', url: siteRoot.href },
  mainEntityOfPage: canonicalUrl.href,
  image: socialImageUrl.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="USIVA" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#162e51" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/assets/usiva-social.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="USIVA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:alt" content="USIVA — visa-readiness and compliance planning" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="USIVA — visa-readiness and compliance planning" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader
      activePath={route}
      topbarMessage="Focused visa guidance; verify current rules with official sources."
      topbarLink={{ label: 'See how USIVA supports planning', href: '/about.html' }}
    />
    <main id="main-content" class="guide-main" tabindex="-1">
      <div class="guide-shell">
        <header class="guide-header">
          <nav class="guide-header__trail" aria-label="Guide context">
            <a href={directoryUrl}>All visa categories</a>
            <span aria-hidden="true">/</span>
            <span>USIVA focused guide</span>
          </nav>
          <div class="guide-header__line">
            <p class="eyebrow">USIVA guidance · {guideType}</p>
            <p class="guide-header__meta">Reviewed {reviewedOn} · informational planning content</p>
          </div>
          <h1>{title}</h1>
          <p class="guide-header__scope">
            Organize a question here, then verify current instructions with the responsible authority and qualified immigration counsel.
          </p>
        </header>
        <article class="guide-document">
          <slot />
        </article>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .guide-main {
    background: var(--color-paper);
    padding-block: clamp(2rem, 4vw, 3.25rem) var(--space-5);
  }

  .guide-shell {
    margin-inline: auto;
    max-width: 72rem;
    padding-inline: var(--gutter);
  }

  .guide-header {
    border-bottom: 1px solid var(--color-line);
    margin-inline: auto;
    max-width: 62rem;
    padding-block-end: var(--space-3);
  }

  .guide-header__trail {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--step--1);
    gap: 0.45rem;
    margin-block-end: var(--space-2);
  }

  .guide-header__trail a {
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  .guide-header__line {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: space-between;
  }

  .guide-header__meta {
    color: var(--color-muted);
    font-size: var(--step--1);
    margin: 0;
  }

  .guide-header__scope {
    border-inline-start: 0.25rem solid var(--color-gold);
    color: var(--color-navy);
    font-size: var(--step--1);
    line-height: 1.55;
    margin-block: var(--space-2) 0;
    max-width: 72ch;
    padding-inline-start: var(--space-2);
  }

  .guide-header__scope a {
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  .guide-document {
    color: var(--color-ink);
    margin-inline: auto;
    max-width: 62rem;
  }

  .guide-header h1,
  .guide-document :global(h1) {
    color: var(--color-navy-deep);
    font-family: var(--font-display);
    font-size: clamp(1.95rem, 4vw, 3.2rem);
    letter-spacing: -0.055em;
    line-height: 1.02;
    margin-block: var(--space-2) var(--space-2);
    max-width: 19ch;
  }

  .guide-document :global(h2) {
    color: var(--color-navy);
    font-size: clamp(1.35rem, 1.15rem + 0.75vw, 1.95rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-block: var(--space-3) var(--space-1);
  }

  .guide-document :global(h3) {
    color: var(--color-navy);
    font-size: var(--step-0);
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin-block: var(--space-2) var(--space-1);
  }

  .guide-document :global(p),
  .guide-document :global(li) {
    font-size: var(--step-0);
    line-height: 1.65;
  }

  .guide-document :global(p) {
    margin-block: 0 var(--space-1);
  }

  .guide-document :global(ul),
  .guide-document :global(ol) {
    margin-block: 0 var(--space-2);
    padding-inline-start: 1.35rem;
  }

  .guide-document :global(li + li) {
    margin-block-start: 0.6rem;
  }

  .guide-document :global(a) {
    color: var(--color-accent-dark);
    font-weight: 750;
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  .guide-document :global(blockquote) {
    background: var(--color-mist);
    border-inline-start: 0.35rem solid var(--color-gold);
    margin: var(--space-2) 0;
    padding: var(--space-2);
  }

  .guide-document :global(blockquote p:last-child) {
    margin-block-end: 0;
  }

  .guide-document :global(table) {
    border-collapse: collapse;
    display: block;
    font-size: var(--step--1);
    margin-block: var(--space-2);
    max-width: 100%;
    overflow-x: auto;
    width: max-content;
  }

  .guide-document :global(th),
  .guide-document :global(td) {
    border: 1px solid var(--color-line);
    padding: 0.6rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }

  .guide-document :global(th) {
    background: var(--color-navy-deep);
    color: var(--color-paper);
  }

  .guide-document :global(code) {
    background: var(--color-mist);
    border-radius: 0.25rem;
    padding: 0.1em 0.28em;
  }

  .guide-document :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin-block: var(--space-4);
  }

  @media (max-width: 620px) {
    .guide-header__line {
      display: block;
    }

    .guide-header__meta {
      margin-block-start: 0.35rem;
    }

    .guide-header h1,
    .guide-document :global(h1) {
      font-size: clamp(1.95rem, 9vw, 3.2rem);
    }
  }
</style>
